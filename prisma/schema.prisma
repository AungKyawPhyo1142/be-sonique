datasource db {
    provider = "postgresql"
    url = env("DATABASE_URL")
}

generator client {
    provider = "prisma-client-js"
}

model User {
    id Int @id @default(autoincrement())
    email String @unique
    username String @unique
    firstName String
    lastName String
    bio String?
    profile_image String?
    password String
    isArtist Boolean @default(false)
}