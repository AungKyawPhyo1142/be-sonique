datasource db {
    provider = "postgresql"
    url      = env("DATABASE_URL")
}

generator client {
    provider = "prisma-client-js"
}

model User {
    id            Int        @id @default(autoincrement())
    email         String     @unique
    username      String     @unique
    firstName     String
    lastName      String
    bio           String?
    profile_image String?
    password      String
    isArtist      Boolean    @default(false)
    created_at    DateTime   @default(now())
    updated_at    DateTime   @updatedAt
    deleted_at    DateTime?
    Song          Song[]
    Album         Album[]
    Playlist      Playlist[]
    LikeSong      LikeSong[]
}

model Album {
    id            Int       @id @default(autoincrement())
    name          String
    description   String?
    coverImage    String?
    coverImageUrl String?
    artistId      Int
    songs         Song[]
    created_at    DateTime  @default(now())
    updated_at    DateTime  @updatedAt
    deleted_at    DateTime?
    User          User?     @relation(fields: [userId], references: [id], onDelete: Cascade)
    userId        Int?
}

model Song {
    id            String    @id @default(uuid())
    title         String
    fileName      String
    fileUrl       String
    duration      Float
    coverImage    String?
    coverImageUrl String?
    genreId       Int
    artistId      Int
    albumId       Int?
    create_at     DateTime  @default(now())
    updated_at    DateTime  @updatedAt
    deleted_at    DateTime?

    User      User           @relation(fields: [artistId], references: [id], onDelete: Cascade)
    Genre     SongGenre      @relation(fields: [genreId], references: [id])
    Album     Album?         @relation(fields: [albumId], references: [id], onDelete: Cascade)
    LikeSong  LikeSong[]
    Playlists PlaylistSong[]
}

model SongGenre {
    id         Int       @id @default(autoincrement())
    name       String    @unique
    created_at DateTime  @default(now())
    updated_at DateTime  @updatedAt
    deleted_at DateTime?

    Songs Song[]
}

model Playlist {
    id     Int    @id @default(autoincrement())
    name   String
    userId Int

    created_at DateTime  @default(now())
    updated_at DateTime  @updatedAt
    deleted_at DateTime?

    user  User           @relation(fields: [userId], references: [id], onDelete: Cascade)
    songs PlaylistSong[]
}

model PlaylistSong {
    id         Int       @id @default(autoincrement())
    playlistId Int
    songId     String
    order      Int // New field to track the order of songs
    created_at DateTime  @default(now())
    updated_at DateTime  @updatedAt
    deleted_at DateTime?
    playlist   Playlist  @relation(fields: [playlistId], references: [id], onDelete: Cascade)
    song       Song      @relation(fields: [songId], references: [id])

    @@unique([playlistId, songId])
}

model LikeSong {
    id         Int       @id @default(autoincrement())
    songId     String
    userId     Int
    created_at DateTime  @default(now())
    updated_at DateTime  @updatedAt
    deleted_at DateTime?

    song Song @relation(fields: [songId], references: [id], onDelete: Cascade)
    user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}
